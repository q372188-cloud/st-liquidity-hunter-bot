-- =====================================
-- Users Access
-- =====================================

create table if not exists users_access (
  id bigserial primary key,
  telegram_id text unique not null,
  username text,
  expires_at timestamptz not null,
  created_at timestamptz default now()
);

-- =====================================
-- Activation Codes
-- =====================================

create table if not exists activation_codes (
  id bigserial primary key,
  code text unique not null,
  days int not null default 30,
  used boolean default false,
  used_by text,
  expires_at timestamptz,
  created_at timestamptz default now()
);

-- =====================================
-- Active Trades
-- =====================================

create table if not exists active_trades (
  id bigserial primary key,
  symbol text not null,
  side text not null,
  strike numeric not null,
  expiration date not null,
  contract_ticker text,
  entry_contract_price numeric,
  current_contract_price numeric,
  stock_entry_price numeric,
  stock_stop_price numeric,
  stock_target_1 numeric,
  stock_target_2 numeric,
  stock_target_3 numeric,
  flow_score int,
  status text default 'OPEN',
  opened_at timestamptz default now(),
  closed_at timestamptz,
  close_reason text,
  last_update_bucket int default 0,
  tp1_hit boolean default false,
  tp2_hit boolean default false,
  tp3_hit boolean default false
);

-- احتياط إذا كان الجدول active_trades موجود مسبقاً
alter table active_trades
add column if not exists last_update_bucket int default 0,
add column if not exists tp1_hit boolean default false,
add column if not exists tp2_hit boolean default false,
add column if not exists tp3_hit boolean default false,
add column if not exists stock_target_3 numeric;

-- =====================================
-- Symbol Cooldowns
-- =====================================

create table if not exists symbol_cooldowns (
  id bigserial primary key,
  symbol text unique not null,
  reason text,
  cooldown_until timestamptz not null,
  created_at timestamptz default now()
);

-- =====================================
-- Sent Flow Alerts
-- =====================================

create table if not exists sent_flow_alerts (
  id bigserial primary key,
  symbol text not null,
  side text not null,
  strike numeric,
  expiration date,
  flow_signature text unique not null,
  created_at timestamptz default now()
);
